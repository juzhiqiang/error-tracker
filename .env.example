DATABASE_URL=postgresql://tracker:tracker@localhost:5434/error_tracker
MINIO_ENDPOINT=localhost
MINIO_PORT=9011
MINIO_ACCESS_KEY=tracker
MINIO_SECRET_KEY=tracker123
MINIO_BUCKET=error-tracker
REDIS_HOST=localhost
REDIS_PORT=6380
NEXT_PUBLIC_API_URL=http://localhost:3002
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3003

# Production security notes:
# - Set NODE_ENV=production in the deployed API process.
# - Replace BETTER_AUTH_SECRET with 32+ random characters, for example openssl rand -base64 32.
# - BETTER_AUTH_URL and every CORS_ORIGIN entry must be HTTPS in production.
# - CORS_ORIGIN may be a comma-separated exact allowlist. Do not use * in production.
# - If the auth API is exposed at a different public URL, set BETTER_AUTH_API_URL=https://api.example.com.

# Optional SMTP invitation email delivery.
# Leave blank in local development to keep invite links copyable without sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Error Tracker <no-reply@example.com>"

# Optional AI Advisor provider.
# Leave OPENAI_API_KEY empty to use the built-in local rules engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional platform self-monitoring.
# Create a project for this Error Tracker deployment, then paste its DSN here.
# Without DSNs, self-monitoring stays disabled.
NEXT_PUBLIC_ERROR_TRACKER_DSN=
ERROR_TRACKER_DSN=
NEXT_PUBLIC_ERROR_TRACKER_SELF_MONITORING_ENABLED=true
ERROR_TRACKER_SELF_MONITORING_ENABLED=true
NEXT_PUBLIC_ERROR_TRACKER_ENVIRONMENT=local
ERROR_TRACKER_ENVIRONMENT=local
NEXT_PUBLIC_ERROR_TRACKER_RELEASE=
ERROR_TRACKER_RELEASE=
