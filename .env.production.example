NODE_ENV=production

# Public URLs.
# Replace these with your server domain or HTTPS reverse-proxy endpoints.
APP_PUBLIC_URL=https://tracker.example.com
API_PUBLIC_URL=https://api.tracker.example.com
NEXT_PUBLIC_API_URL=https://api.tracker.example.com
BETTER_AUTH_URL=https://tracker.example.com
BETTER_AUTH_API_URL=https://api.tracker.example.com
CORS_ORIGIN=https://tracker.example.com

# Generate a 32+ character secret before production use:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-32-plus-character-secret

# Internal Docker network service addresses.
DATABASE_URL=postgresql://tracker:replace-postgres-password@postgres:5432/error_tracker
REDIS_HOST=redis
REDIS_PORT=6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=tracker
MINIO_SECRET_KEY=replace-minio-password
MINIO_BUCKET=error-tracker

# Database container bootstrap values.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=replace-postgres-password
POSTGRES_DB=error_tracker

# MinIO container bootstrap values.
MINIO_ROOT_USER=tracker
MINIO_ROOT_PASSWORD=replace-minio-password

# Optional ingest limits.
INGEST_MAX_BODY_BYTES=524288
REPLAY_MAX_BODY_BYTES=5242880
INGEST_RATE_WINDOW_MS=60000
INGEST_RATE_MAX_REQUESTS=300
INGEST_DAILY_EVENT_QUOTA=100000

# Optional SMTP invitation email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Error Tracker <no-reply@example.com>

# Optional AI Advisor provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional platform self-monitoring.
NEXT_PUBLIC_ERROR_TRACKER_DSN=
NEXT_PUBLIC_ERROR_TRACKER_TOKEN=
NEXT_PUBLIC_ERROR_TRACKER_SELF_MONITORING_ENABLED=false
NEXT_PUBLIC_ERROR_TRACKER_ENVIRONMENT=production
NEXT_PUBLIC_ERROR_TRACKER_RELEASE=
ERROR_TRACKER_DSN=
ERROR_TRACKER_TOKEN=
ERROR_TRACKER_SELF_MONITORING_ENABLED=false
ERROR_TRACKER_ENVIRONMENT=production
ERROR_TRACKER_RELEASE=
